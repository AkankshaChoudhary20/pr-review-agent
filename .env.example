# Server
PORT=3000

# Postgres connection string — matches the defaults in docker-compose.yml.
# If you change POSTGRES_USER/PASSWORD/DB in docker-compose.yml, update this too.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/ai_pr_reviewer

# --- GitHub -----------------------------------------------------------------

# Secret configured on the GitHub webhook (repo or org Settings > Webhooks).
# Used to verify the X-Hub-Signature-256 header on every incoming webhook.
GITHUB_WEBHOOK_SECRET=

# Personal access token used to fetch PR diffs and post review comments back.
# Needs `repo` scope (classic PAT) or Contents:Read + Pull requests:Read&Write
# (fine-grained PAT). See README.md for step-by-step instructions.
GITHUB_TOKEN=

# --- Anthropic ----------------------------------------------------------------

# API key from https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Optional — model used to generate reviews. Defaults to claude-sonnet-5 if unset.
CLAUDE_MODEL=claude-sonnet-5
